<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>$(LibraryName)</PackageId>
		<VersionPrefix>1.0.0</VersionPrefix>
		<Authors>colton.murphy</Authors>
		<Company>CeetemSoft</Company>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<AssemblyName>$(PackageId)</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TargetFramework>net11.0</TargetFramework>
		<LangVersion>preview</LangVersion> 
	</PropertyGroup>
	
	<ItemGroup>
		<None
			Include="assets/*" Pack="true"
			PackagePath="build/" />

  		<None
			Include="$(LuaJitDir)luajit.lib" Pack="true"
			PackagePath="$(LuaJitRuntimesDir)"/>

		<None
			Include="$(LuaJitDir)luajit.dll" Pack="true"
			PackagePath="$(LuaJitRuntimesDir)"/>
	</ItemGroup>
</Project>
